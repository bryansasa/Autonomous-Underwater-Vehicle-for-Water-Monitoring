<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="saguling_reservoir">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugin Sistem Buoyancy (Gaya Apung Air) -->
    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <linear_ramp>
            <starting_physical_height>0.0</starting_physical_height>
            <ending_physical_height>-5.0</ending_physical_height>
            <starting_density>998.0</starting_density>
            <ending_density>1002.0</ending_density>
          </linear_ramp>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <!-- Plugin Fisika & Adegan Dasar -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Pencahayaan Sinar Matahari -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.8 0.9 1.0 1</diffuse>
      <specular>0.2 0.3 0.4 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Dasar Waduk Saguling (Kedalaman 5 meter) -->
    <model name="reservoir_bottom">
      <static>true</static>
      <pose>0 0 -5.0 0 0 0</pose>
      <link name="bottom_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 30 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 30 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.22 0.18 1</ambient>
            <diffuse>0.3 0.32 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Permukaan Air Waduk (Transparan Biru Kehijauan) -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="surface_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>30 30 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.5 0.5</ambient>
            <diffuse>0.15 0.5 0.6 0.6</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
