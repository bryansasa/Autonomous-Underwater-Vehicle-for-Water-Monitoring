<?xml version="1.0"?>
<package format="3">
  <name>tyrant_sim</name>
  <version>0.1.0</version>
  <description>Reduced plant HIL simulator and deterministic SysID excitation tools for Tyrant AUV.</description>
  <maintainer email="devnull@example.com">Tyrant AUV</maintainer>
  <license>MIT</license>


  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tyrant_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
